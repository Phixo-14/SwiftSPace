NODE_ENV=development
PORT=5000

# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/swiftspace
MONGO_URI=mongodb://127.0.0.1:27017/room-designer
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin SDK service-account values
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-adminsdk-client-email
FIREBASE_PRIVATE_KEY=your-firebase-service-account-private-key
# Used only as a fallback when the Admin SDK credentials are unavailable.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password

# Optional fallback email-code delivery when Firebase is not configured
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=
